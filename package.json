{
  "name": "relocateos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^4.15.9"
    }
  },
  "scripts": {
    "dev": "npm run build:functions && concurrently -n web,fb -c cyan,magenta \"npm:dev:web\" \"npm:emulators\"",
    "dev:web": "next dev",
    "build": "next build",
    "build:functions": "npm --prefix functions run build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && npm --prefix functions run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functions": "npm --prefix functions run test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions --project relocateos-dev",
    "firebase": "firebase"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "docx": "^9.12.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "geist": "^1.8.1",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.1",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "^15.34.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
